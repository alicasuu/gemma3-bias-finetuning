      ],
      "source": [
        "from collections import defaultdict\n",
        "import json\n",
        "import hashlib\n",
        "import pandas as pd\n",
        "\n",
        "RACE_PROMPT_FILE = BOLD_REPO / \"prompts\" / \"race_prompt.json\"\n",
        "\n",
        "assert RACE_PROMPT_FILE.exists(), (\n",
        "    f\"Could not find: {RACE_PROMPT_FILE}\"\n",
        ")\n",
        "\n",
        "def stable_rank(seed, row):\n",
        "    identity = (\n",
        "        f\"{seed}|{row['domain']}|{row['category']}|\"\n",
        "        f\"{row['name']}|{row['prompt_index']}|{row['prompt']}\"\n",
        "    )\n",
        "    return hashlib.sha256(identity.encode(\"utf-8\")).hexdigest()\n",
        "\n",
        "\n",
        "def load_bold_race_prompts():\n",
        "    with open(RACE_PROMPT_FILE, \"r\", encoding=\"utf-8\") as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    rows = []\n",
        "\n",
        "    # Official BOLD format:\n",
        "    # category -> subject/person -> list of prompts\n",
        "    for category, subjects in data.items():\n",
        "        for name, prompts in subjects.items():\n",
        "            for prompt_index, prompt in enumerate(prompts):\n",
        "                rows.append({\n",
        "                    \"domain\": \"race\",\n",
        "                    \"category\": category,\n",
        "                    \"name\": name,\n",
        "                    \"prompt\": prompt,\n",
        "                    \"prompt_index\": str(prompt_index),\n",
        "                })\n",
        "\n",
        "    return rows\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Load official BOLD race prompts\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "all_prompts = load_bold_race_prompts()\n",
        "\n",
        "print(\"Total BOLD race prompts found:\", len(all_prompts))\n",
        "\n",
        "grouped = defaultdict(list)\n",
        "\n",
        "for row in all_prompts:\n",
        "    grouped[row[\"category\"]].append(row)\n",
        "\n",
        "print(\"\\nRace categories found:\")\n",
        "for category in sorted(grouped):\n",
        "    print(f\"  {category}: {len(grouped[category])}\")\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Verify expected four categories from Elias's implementation\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if set(grouped) != set(RACE_CATEGORIES):\n",
        "    raise ValueError(\n",
        "        \"BOLD race category contract differs from Elias's reference.\\n\"\n",
        "        f\"Expected: {sorted(RACE_CATEGORIES)}\\n\"\n",
        "        f\"Found: {sorted(grouped)}\"\n",
        "    )\n",
        "\n",
        "maximum = min(\n",
        "    len(grouped[category])\n",
        "    for category in RACE_CATEGORIES\n",
        ")\n",
        "\n",
        "print(\"\\nMaximum balanced samples/category:\", maximum)\n",
        "\n",
        "if not 1 <= SAMPLES_PER_CATEGORY <= maximum:\n",
        "    raise ValueError(\n",
        "        f\"SAMPLES_PER_CATEGORY must be between 1 and {maximum}\"\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Deterministically select equal samples from every category\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "selected = []\n",
        "\n",
        "for category in RACE_CATEGORIES:\n",
        "    ranked = sorted(\n",
        "        grouped[category],\n",
        "        key=lambda row: stable_rank(SEED, row)\n",
        "    )\n",
        "\n",
        "    selected.extend(\n",
        "        ranked[:SAMPLES_PER_CATEGORY]\n",
        "    )\n",
        "\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Build frozen task table\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "tasks_df = pd.DataFrame(selected)\n",
        "\n",
        "tasks_df[\"task_key\"] = tasks_df.apply(\n",
        "    lambda r: \"bold-race-\" + hashlib.sha256(\n",
        "        (\n",
        "            f\"{r['category']}|\"\n",
        "            f\"{r['name']}|\"\n",
        "            f\"{r['prompt_index']}|\"\n",
        "            f\"{r['prompt']}\"\n",
        "        ).encode(\"utf-8\")\n",
        "    ).hexdigest()[:20],\n",
        "    axis=1,\n",
        ")\n",
        "\n",
        "tasks_df = tasks_df[\n",
        "    [\n",
        "        \"task_key\",\n",
        "        \"domain\",\n",
        "        \"category\",\n",
        "        \"name\",\n",
        "        \"prompt_index\",\n",
        "        \"prompt\",\n",
        "    ]\n",
        "].copy()\n",
        "\n",
        "assert tasks_df[\"task_key\"].is_unique\n",
        "\n",
        "expected_n = (\n",
        "    SAMPLES_PER_CATEGORY\n",
        "    * len(RACE_CATEGORIES)\n",
        ")\n",
        "\n",
        "assert len(tasks_df) == expected_n, (\n",
        "    f\"Expected {expected_n} tasks, got {len(tasks_df)}\"\n",
        ")\n",
        "\n",
        "tasks_df.to_csv(\n",
        "    FROZEN_INPUTS_CSV,\n",
        "    index=False\n",
        ")\n",
        "\n",
        "display(tasks_df.head())\n",
        "\n",
        "display(\n",
        "    tasks_df\n",
        "    .groupby(\"category\")\n",
        "    .size()\n",
        "    .rename(\"n\")\n",
        ")\n",
        "\n",
        "print(\"\\n✅ Frozen inputs:\", FROZEN_INPUTS_CSV)\n",
        "print(\"✅ Total tasks/model:\", len(tasks_df))"
      ]
    },
