        "## 6. Optional description tasks + stereotype lexicon"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "1c8e9422",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "1c8e9422",
        "outputId": "9552dfea-7f27-4623-960e-8a0702b4eeac"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Loaded VisBias stereotype lexicon\n",
            "Description calls/model if enabled: 280\n"
          ]
        }
      ],
      "source": [
        "\n",
        "description_rows = []\n",
        "\n",
        "for _, row in pair_df.iterrows():\n",
        "    for race in (\"black\", \"white\"):\n",
        "        description_rows.append({\n",
        "            \"task_key\": f\"description|{row['pair_id']}|{race}\",\n",
        "            \"matched_pair_id\": row[\"pair_id\"],\n",
        "            \"occupation\": row[\"occupation\"],\n",
        "            \"gender\": row[\"gender\"],\n",
        "            \"source_index\": int(row[\"source_index\"]),\n",
        "            \"race\": race,\n",
        "            \"image\": row[f\"{race}_image\"],\n",
        "            \"prompt\": DESCRIPTION_PROMPT,\n",
        "        })\n",
        "\n",
        "description_tasks = pd.DataFrame(description_rows)\n",
        "description_tasks.to_csv(DESCRIPTION_TASKS_CSV, index=False)\n",
        "\n",
        "lexicon_path = VISBIAS_REPO / \"code\" / \"image_description\" / \"stereo_dict.pkl\"\n",
        "\n",
        "race_lexicons = {\"black\": [], \"white\": []}\n",
        "\n",
        "if lexicon_path.exists():\n",
        "    with open(lexicon_path, \"rb\") as f:\n",
        "        source_lexicon = pickle.load(f)\n",
        "\n",
        "    for race_name in (\"Black\", \"White\"):\n",
        "        words = {\n",
        "            str(word).strip().lower()\n",
        "            for role in (\"person\", \"man\", \"woman\")\n",
        "            for word in source_lexicon[role][race_name]\n",
        "        }\n",
        "\n",
        "        race_lexicons[race_name.lower()] = sorted(words)\n",
        "\n",
        "    with open(LEXICON_JSON, \"w\", encoding=\"utf-8\") as f:\n",
        "        json.dump(race_lexicons, f, indent=2)\n",
        "\n",
        "    print(\"✅ Loaded VisBias stereotype lexicon\")\n",
        "else:\n",
        "    print(\"⚠️ stereo_dict.pkl not found; comparison analysis still works.\")\n",
        "\n",
        "print(\"Description calls/model if enabled:\", len(description_tasks))\n"
      ]
    },
