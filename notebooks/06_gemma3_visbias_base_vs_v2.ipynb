        "## 4. Freeze exactly 1,000 matched Black–White image pairs"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "416b8dfa",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 388,
          "referenced_widgets": [
            "00706441e99846d0bf65e39f5ebe3db5",
            "686db1710f0744c68e099b18bacb8f13",
            "ef5607b615684a2b990d2dea9a9c8d2a",
            "d7ef2273c26e4f41952d548ef248c3fb",
            "cd4c5128ec3e4f678d4d938a672ac1b9",
            "eaaecd1c2d864f318f4f63dfa9cf0dec",
            "f84f082b91584117a9032de886965832",
            "14878ff77ead41738d81894c70ac8a8f",
            "e82363d629664df9a15aa207eb18b559",
            "1a0505d1b5e9449aa6ac62035ca6ae2b",
            "241c32188efd4cb18d792135be26d55b"
