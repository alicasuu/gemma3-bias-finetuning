        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "✅ Saved: /content/drive/MyDrive/IAT/results/visbias/gemma3_base_vs_v2/frozen_inputs/matched_pairs.csv\n"
          ]
        }
      ],
      "source": [
        "\n",
        "from PIL import Image, ImageOps\n",
        "from tqdm.auto import tqdm\n",
        "\n",
        "def stable_hash(text):\n",
        "    return hashlib.sha256(text.encode(\"utf-8\")).hexdigest()\n",
        "\n",
        "def normalize_image(source, destination, max_dimension=512, jpeg_quality=90):\n",
        "    destination.parent.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "    with Image.open(source) as im:\n",
        "        im = ImageOps.exif_transpose(im).convert(\"RGB\")\n",
        "        im.thumbnail(\n",
        "            (max_dimension, max_dimension),\n",
        "            Image.Resampling.LANCZOS,\n",
        "        )\n",
        "        im.save(\n",
        "            destination,\n",
        "            format=\"JPEG\",\n",
        "            quality=jpeg_quality,\n",
        "            optimize=True,\n",
        "            progressive=False,\n",
        "        )\n",
        "\n",
        "def numeric_stem(path):\n",
        "    try:\n",
        "        return int(path.stem)\n",
        "    except Exception:\n",
        "        return None\n",
        "\n",
        "candidate_pairs = []\n",
        "\n",
        "for occupation in OCCUPATIONS:\n",
        "    for gender in GENDERS:\n",
        "\n",
        "        black_dir = SOURCE_IMAGE_ROOT / occupation / f\"black_{gender}\"\n",
        "        white_dir = SOURCE_IMAGE_ROOT / occupation / f\"white_{gender}\"\n",
        "\n",
        "        if not black_dir.exists() or not white_dir.exists():\n",
        "            print(\"⚠️ Missing cell:\", occupation, gender)\n",
        "            continue\n",
        "\n",
        "        black_files = {\n",
        "            numeric_stem(p): p\n",
        "            for p in black_dir.glob(\"*.jpg\")\n",
        "            if numeric_stem(p) is not None\n",
        "        }\n",
        "\n",
        "        white_files = {\n",
        "            numeric_stem(p): p\n",
        "            for p in white_dir.glob(\"*.jpg\")\n",
        "            if numeric_stem(p) is not None\n",
        "        }\n",
        "\n",
        "        common = sorted(\n",
        "            set(black_files) & set(white_files)\n",
        "        )\n",
        "\n",
        "        for source_index in common:\n",
        "            candidate_pairs.append({\n",
        "                \"pair_id\": f\"{occupation}|{gender}|{source_index}\",\n",
        "                \"occupation\": occupation,\n",
        "                \"gender\": gender,\n",
        "                \"source_index\": source_index,\n",
        "                \"black_source\": str(black_files[source_index]),\n",
        "                \"white_source\": str(white_files[source_index]),\n",
        "            })\n",
        "\n",
        "print(\"Candidate matched pairs:\", len(candidate_pairs))\n",
        "\n",
        "if len(candidate_pairs) < TARGET_MATCHED_PAIRS:\n",
        "    raise ValueError(\n",
        "        f\"Only {len(candidate_pairs)} matched pairs are available, \"\n",
        "        f\"but TARGET_MATCHED_PAIRS={TARGET_MATCHED_PAIRS}.\"\n",
        "    )\n",
        "\n",
        "# Deterministic balanced-ish selection:\n",
        "# sort each occupation/gender cell by seeded hash, then round-robin.\n",
        "by_cell = {}\n",
        "\n",
        "for row in candidate_pairs:\n",
        "    key = (row[\"occupation\"], row[\"gender\"])\n",
        "    by_cell.setdefault(key, []).append(row)\n",
        "\n",
        "for key in by_cell:\n",
        "    by_cell[key] = sorted(\n",
        "        by_cell[key],\n",
        "        key=lambda r: stable_hash(f\"{SEED}|{r['pair_id']}\")\n",
        "    )\n",
        "\n",
        "cell_keys = sorted(by_cell)\n",
        "\n",
        "selected = []\n",
        "offsets = {key: 0 for key in cell_keys}\n",
        "\n",
        "while len(selected) < TARGET_MATCHED_PAIRS:\n",
        "    made_progress = False\n",
        "\n",
        "    for key in cell_keys:\n",
        "        if len(selected) >= TARGET_MATCHED_PAIRS:\n",
        "            break\n",
        "\n",
        "        idx = offsets[key]\n",
        "\n",
        "        if idx >= len(by_cell[key]):\n",
        "            continue\n",
        "\n",
        "        selected.append(by_cell[key][idx])\n",
        "        offsets[key] += 1\n",
        "        made_progress = True\n",
        "\n",
        "    if not made_progress:\n",
        "        raise RuntimeError(\"Could not fill balanced matched-pair sample.\")\n",
        "\n",
        "pair_df = pd.DataFrame(selected)\n",
        "\n",
        "print(pair_df.groupby([\"occupation\", \"gender\"]).size())\n",
        "print(\"Selected matched pairs:\", len(pair_df))\n",
        "\n",
        "# Normalize/copy selected images to Drive once so resumed runs do not depend on /content.\n",
        "normalized_rows = []\n",
        "\n",
        "for _, row in tqdm(pair_df.iterrows(), total=len(pair_df), desc=\"Normalize images\"):\n",
        "\n",
        "    pair_id = row[\"pair_id\"]\n",
        "    occupation = row[\"occupation\"]\n",
        "    gender = row[\"gender\"]\n",
        "    source_index = int(row[\"source_index\"])\n",
        "\n",
        "    out_black = (\n",
        "        IMAGE_ROOT / occupation / f\"black_{gender}\" / f\"{source_index}.jpg\"\n",
        "    )\n",
        "    out_white = (\n",
        "        IMAGE_ROOT / occupation / f\"white_{gender}\" / f\"{source_index}.jpg\"\n",
        "    )\n",
        "\n",
        "    if not out_black.exists():\n",
        "        normalize_image(Path(row[\"black_source\"]), out_black)\n",
        "\n",
        "    if not out_white.exists():\n",
        "        normalize_image(Path(row[\"white_source\"]), out_white)\n",
        "\n",
        "    normalized_rows.append({\n",
        "        **row.to_dict(),\n",
        "        \"black_image\": str(out_black),\n",
        "        \"white_image\": str(out_white),\n",
        "    })\n",
        "\n",
        "pair_df = pd.DataFrame(normalized_rows)\n",
        "pair_df.to_csv(PAIR_MANIFEST_CSV, index=False)\n",
        "\n",
        "print(\"✅ Saved:\", PAIR_MANIFEST_CSV)\n"
      ]
    },
