      "source": [
        "\n",
        "from collections import defaultdict\n",
        "\n",
        "CAPITALIZED_TARGET_GROUPS = {\n",
        "    \"Muslims\", \"Asians\", \"Jews\", \"Mexicans\", \"Latin Americans\",\n",
        "    \"Christians\", \"Canadians\", \"Europeans\", \"Americans\",\n",
        "    \"Caucasians\", \"Buddhists\",\n",
        "}\n",
        "\n",
        "def load_system_prompts():\n",
        "    s = pd.read_csv(SYSTEM_PROMPTS_CSV)\n",
        "    return dict(zip(s[\"type\"], s[\"system_prompt\"]))\n",
        "\n",
        "def load_dataset_rows():\n",
        "    rows = []\n",
        "    with open(STEREOTYPE_JSONL, encoding=\"utf-8\") as f:\n",
        "        for line in f:\n",
        "            prompt = json.loads(line)[\"prompt\"]\n",
        "            rows.append({\n",
        "                \"text\": prompt[\"text\"],\n",
        "                \"topic\": prompt[\"stereotype_topic_tag\"],\n",
        "                \"demographic_group\": prompt[\"demographic_group_tag\"],\n",
        "                \"regime\": prompt[\"sys_prompt_type_tag\"],\n",
        "            })\n",
        "\n",
        "    if len(rows) != 3456:\n",
        "        raise ValueError(f\"Expected 3,456 DecodingTrust rows, got {len(rows)}\")\n",
        "    return rows\n",
        "\n",
        "def build_race_tasks(topics_per_group=None, seed=42):\n",
        "    rows = load_dataset_rows()\n",
        "    system_prompts = load_system_prompts()\n",
        "\n",
        "    topics = sorted({r[\"topic\"] for r in rows})\n",
        "    if topics_per_group is None:\n",
        "        selected_topics = topics\n",
        "    else:\n",
        "        if not 1 <= topics_per_group <= len(topics):\n",
        "            raise ValueError(f\"topics_per_group must be 1..{len(topics)}\")\n",
        "        selected_topics = sorted(\n",
        "            topics,\n",
        "            key=lambda t: hashlib.sha256(f\"{seed}|{t}\".encode()).hexdigest()\n",
        "        )[:topics_per_group]\n",
        "\n",
        "    indexed = defaultdict(list)\n",
        "    for r in rows:\n",
        "        indexed[(r[\"regime\"], r[\"topic\"], r[\"demographic_group\"])].append(r)\n",
        "\n",
        "    tasks = []\n",
        "    for regime in REGIMES:\n",
        "        for group in RACE_GROUPS:\n",
        "            for topic in selected_topics:\n",
        "                candidates = sorted(\n",
        "                    indexed[(regime, topic, group)],\n",
        "                    key=lambda r: r[\"text\"]\n",
        "                )\n",
        "                if not candidates:\n",
        "                    raise ValueError(f\"Missing matched cell: {regime} / {group} / {topic}\")\n",
        "\n",
        "                identity = hashlib.sha256(\n",
        "                    f\"{seed}|{regime}|{group}|{topic}\".encode()\n",
        "                ).hexdigest()\n",
        "                row = candidates[int(identity[:8], 16) % len(candidates)]\n",
        "\n",
        "                system_target = (\n",
        "                    group if group in CAPITALIZED_TARGET_GROUPS else group.lower()\n",
        "                )\n",
        "                system_prompt = system_prompts[regime].replace(\n",
        "                    \"[target_group]\", system_target\n",
        "                )\n",
        "\n",
        "                task_key = hashlib.sha256(\n",
        "                    f\"{regime}|{group}|{topic}|{row['text']}\".encode()\n",
        "                ).hexdigest()[:24]\n",
        "\n",
        "                tasks.append({\n",
        "                    \"task_key\": task_key,\n",
        "                    \"regime\": regime,\n",
        "                    \"topic\": topic,\n",
        "                    \"demographic_group\": group,\n",
        "                    \"system_prompt\": system_prompt,\n",
        "                    \"prompt\": row[\"text\"],\n",
        "                })\n",
        "\n",
        "    return pd.DataFrame(tasks)\n",
        "\n",
        "tasks_df = build_race_tasks(TOPICS_PER_GROUP, SEED)\n",
        "\n",
        "# Freeze the exact evaluation inputs to Drive.\n",
        "tasks_df.to_csv(FROZEN_INPUTS_CSV, index=False)\n",
        "\n",
        "print(\"Tasks:\", len(tasks_df))\n",
        "print(\"Topics:\", tasks_df[\"topic\"].nunique())\n",
        "print(tasks_df.groupby([\"regime\", \"demographic_group\"]).size())\n",
        "display(tasks_df.head())\n",
        "\n",
        "assert tasks_df.duplicated(\"task_key\").sum() == 0\n"
      ]
    },
